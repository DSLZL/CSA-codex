+#[test]
+fn startup_mouse_policy_applies_after_logging_and_warns_once_without_raw_value() {
+    for (input, expected, warns) in [
+        (
+            Err(VarError::NotPresent),
+            SubagentLiveMouseMode::Auto,
+            false,
+        ),
+        (Ok("auto".to_string()), SubagentLiveMouseMode::Auto, false),
+        (Ok("on".to_string()), SubagentLiveMouseMode::On, false),
+        (Ok("off".to_string()), SubagentLiveMouseMode::Off, false),
+        (
+            Ok("private-invalid-value".to_string()),
+            SubagentLiveMouseMode::Auto,
+            true,
+        ),
+        (
+            Err(VarError::NotUnicode(std::ffi::OsString::new())),
+            SubagentLiveMouseMode::Auto,
+            true,
+        ),
+    ] {
+        // Startup creates the draft terminal before installing its tracing subscriber.
+        let mut tui = crate::tui::test_support::make_test_tui().expect("draft terminal");
+        assert_eq!(tui.subagent_live_mouse_mode, SubagentLiveMouseMode::Auto);
+        let capture = tempfile::NamedTempFile::new().expect("log capture");
+        let subscriber = tracing_subscriber::fmt()
+            .without_time()
+            .with_ansi(false)
+            .with_target(false)
+            .with_level(false)
+            .with_writer(Arc::new(capture.reopen().expect("log writer")))
+            .finish();
+        tracing::subscriber::with_default(subscriber, || {
+            tui.configure_subagent_live_mouse(input);
+        });
+        assert_eq!(tui.subagent_live_mouse_mode, expected);
+        let logged = std::fs::read_to_string(capture.path()).expect("captured warning");
+        assert_eq!(
+            logged.trim(),
+            if warns {
+                "invalid CSA_SUBAGENT_LIVE_MOUSE; using auto"
+            } else {
+                ""
+            }
+        );
+    }
+}
