+impl SubagentLiveMouseMode {
+    pub(super) fn from_env_value(value: std::result::Result<String, VarError>) -> Self {
+        match value.as_deref() {
+            Err(VarError::NotPresent) | Ok("auto") => Self::Auto,
+            Ok("on") => Self::On,
+            Ok("off") => Self::Off,
+            Ok(_) | Err(VarError::NotUnicode(_)) => {
+                tracing::warn!("invalid CSA_SUBAGENT_LIVE_MOUSE; using auto");
+                Self::Auto
+            }
+        }
+    }
