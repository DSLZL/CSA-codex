+        (Ok("auto".to_string()), SubagentLiveMouseMode::Auto),
+        (Ok("on".to_string()), SubagentLiveMouseMode::On),
+        (Ok("off".to_string()), SubagentLiveMouseMode::Off),
+        (Ok(String::new()), SubagentLiveMouseMode::Auto),
+        (Ok("invalid".to_string()), SubagentLiveMouseMode::Auto),
+        (
