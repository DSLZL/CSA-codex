+async fn multi_agent_v2_followup_restores_same_child_and_never_spawns_on_errors() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    let mut config = (*turn.config).clone();
+    for feature in [Feature::MultiAgentV2, Feature::Sqlite] {
+        config.features.enable(feature).expect("enable v2 storage");
+    }
+    let state_db = init_state_db(&config).await.expect("initialize state db");
+    let manager = ThreadManager::with_models_provider_home_and_state_for_tests(
+        CodexAuth::from_api_key("dummy"),
+        config.model_provider.clone(),
+        config.codex_home.to_path_buf(),
+        Arc::new(codex_exec_server::EnvironmentManager::default_for_tests()),
+        Some(state_db),
+    );
+    let root = manager
+        .start_thread(StartThreadOptions::new(config.clone()))
+        .await
+        .expect("start parent");
+    root.thread.session.new_default_turn().await;
+    session.services.agent_control = root.thread.session.services.agent_control.clone();
+    session.thread_id = root.thread_id;
+    set_turn_config(&mut turn, config);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+    SpawnAgentHandlerV2::default()
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "spawn_agent",
+            function_payload(json!({"task_name": "worker", "message": "original work"})),
+        ))
+        .await
+        .expect("spawn original worker");
+    let control = &session.services.agent_control;
+    let agent_id = control
+        .resolve_agent_reference(session.thread_id, &turn.session_source, "worker")
+        .await
+        .expect("resolve original worker");
+
+    for (target, message) in [
+        (ThreadId::new().to_string(), "fix the failed test"),
+        ("worker".to_string(), " \t\n "),
+    ] {
+        let before_ids = manager.list_thread_ids().await;
+        let before_ops = manager.captured_ops().len();
+        let error = FollowupTaskHandlerV2
+            .handle(invocation(
+                session.clone(),
+                turn.clone(),
+                "followup_task",
+                function_payload(json!({"target": target, "message": message})),
+            ))
+            .await
+            .err()
+            .expect("invalid follow-up should fail");
+        assert!(matches!(error, FunctionCallError::RespondToModel(_)));
+        assert_eq!(manager.list_thread_ids().await, before_ids);
+        assert_eq!(manager.captured_ops().len(), before_ops);
+    }
+
+    let worker = manager.get_thread(agent_id).await.expect("loaded worker");
+    worker
+        .inject_response_items(vec![ResponseItem::Message {
+            id: None,
+            role: "user".to_string(),
+            content: vec![ContentItem::InputText {
+                text: "durable original worker context".to_string(),
+            }],
+            phase: None,
+            internal_chat_message_metadata_passthrough: None,
+        }])
+        .await
+        .expect("persist child context");
+    worker.shutdown_and_wait().await.expect("flush and unload");
+    let rollout_path = worker
+        .read_thread(
+            /*include_archived*/ true, /*include_history*/ false,
+        )
+        .await
+        .expect("read native child metadata")
+        .rollout_path
+        .expect("durable child rollout");
+    assert!(manager.remove_thread(&agent_id).await.is_some());
+    assert!(control.ensure_agent_known(agent_id).is_ok());
+    let output = FollowupTaskHandlerV2
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "followup_task",
+            function_payload(json!({
+                "target": "/root/worker",
+                "message": "review findings for the original worker",
+            })),
+        ))
+        .await
+        .expect("direct follow-up should reload the same child");
+    assert_eq!(expect_text_output(output), (String::new(), Some(true)));
+    let restored = manager.get_thread(agent_id).await.expect("same child ID");
+    assert_eq!(manager.list_thread_ids().await.len(), 2);
+    assert!(manager.captured_ops().iter().any(|(id, op)| {
+        *id == agent_id
+            && matches!(op, Op::InterAgentCommunication { communication, .. }
+                if communication.recipient.as_str() == "/root/worker"
+                    && communication.trigger_turn
+                    && communication.encrypted_content.as_deref()
+                        == Some("review findings for the original worker"))
+    }));
+
+    restored
+        .shutdown_and_wait()
+        .await
+        .expect("unload restored child");
+    assert!(manager.remove_thread(&agent_id).await.is_some());
+    let rollout_path = std::fs::canonicalize(rollout_path).expect("fixture rollout path");
+    let fixture_home = std::fs::canonicalize(&turn.config.codex_home).expect("fixture home");
+    assert!(rollout_path.starts_with(fixture_home));
+    std::fs::remove_file(rollout_path).expect("simulate unavailable native child history");
+    for explicitly_closed in [false, true] {
+        if explicitly_closed {
+            control
+                .close_agent(agent_id)
+                .await
+                .expect("close unavailable child");
+        }
+        let before_ops = manager.captured_ops().len();
+        let error = FollowupTaskHandlerV2
+            .handle(invocation(
+                session.clone(),
+                turn.clone(),
+                "followup_task",
+                function_payload(json!({
+                    "target": agent_id.to_string(),
+                    "message": "continue the original worker only",
+                })),
+            ))
+            .await
+            .err()
+            .expect("unavailable or closed child must not be replaced");
+        assert!(matches!(error, FunctionCallError::RespondToModel(_)));
+        assert_eq!(manager.list_thread_ids().await, vec![root.thread_id]);
+        assert_eq!(manager.captured_ops().len(), before_ops);
+    }
+}
