+        .expect("spawn worker");
+    let (spawn_output, _) = expect_text_output(spawn_output);
+    let spawn_output: serde_json::Value =
+        serde_json::from_str(&spawn_output).expect("spawn result should be json");
+    let worker_path = spawn_output["task_name"]
+        .as_str()
+        .expect("spawn result task name");
+    let worker_id = session
+        .services
+        .agent_control
+        .resolve_agent_reference(session.thread_id, &turn.session_source, worker_path)
+        .await
+        .expect("spawned worker should resolve");
+
+    let unknown_run_error = JoinAgentHandler
+        .handle(invocation(
+            session.clone(),
+            turn.clone(),
+            "join_agent",
+            function_payload(json!({"target": worker_path, "run_id": "unknown-run"})),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject an unknown exact run");
+    assert_eq!(
+        unknown_run_error,
+        FunctionCallError::RespondToModel(format!(
+            "unknown run_id for target {worker_path}: no native run receipt exists for the supplied target/run_id pair"
+        ))
+    );
+
+    Arc::get_mut(&mut session)
+        .expect("test session should be uniquely owned")
+        .thread_id = worker_id;
+    Arc::get_mut(&mut turn)
+        .expect("test turn should be uniquely owned")
+        .session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+        parent_thread_id: root.thread_id,
+        depth: 1,
+        agent_path: Some(AgentPath::try_from(worker_path).expect("worker path")),
+        agent_nickname: None,
+        agent_role: None,
+    });
+    let self_error = JoinAgentHandler
+        .handle(invocation(
+            session,
+            turn,
+            "join_agent",
+            function_payload(json!({"target": worker_id.to_string(), "run_id": "run"})),
+        ))
+        .await
+        .err()
+        .expect("join_agent should reject self");
+    assert_eq!(
+        self_error,
+        FunctionCallError::RespondToModel("an agent cannot join its own run".to_string())
+    );
+}
