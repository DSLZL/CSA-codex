+#[tokio::test]
+async fn join_agents_waits_for_every_exact_run_and_preserves_order() {
+    let (mut session, mut turn) = make_session_and_context().await;
+    let manager = thread_manager();
+    let root = manager
+        .start_thread(StartThreadOptions::new((*turn.config).clone()))
+        .await
+        .expect("root thread should start");
+    session.services.agent_control = manager.agent_control();
+    session.thread_id = root.thread_id;
+    let mut config = (*turn.config).clone();
+    config
+        .features
+        .enable(Feature::MultiAgentV2)
+        .expect("test config should allow feature update");
+    set_turn_config(&mut turn, config);
+    let session = Arc::new(session);
+    let turn = Arc::new(turn);
+
+    let mut agents = Vec::new();
+    let mut targets = Vec::new();
+    let mut runs = Vec::new();
+    let mut arguments = Vec::new();
+    for name in ["a", "b", "c"] {
+        let output = SpawnAgentHandlerV2::default()
+            .handle(invocation(
+                session.clone(),
+                turn.clone(),
+                "spawn_agent",
+                function_payload(json!({
+                    "message": format!("read fixture {name}"),
+                    "task_name": format!("worker_{name}")
+                })),
+            ))
+            .await
+            .expect("spawn worker");
+        let (output, _) = expect_text_output(output);
+        let output: serde_json::Value =
+            serde_json::from_str(&output).expect("spawn result should be json");
+        let target = output["task_name"]
+            .as_str()
+            .expect("spawn result task name")
+            .to_string();
+        let agent_id = session
+            .services
+            .agent_control
+            .resolve_agent_reference(session.thread_id, &turn.session_source, &target)
+            .await
+            .expect("spawned worker should resolve");
+        let run_id = format!("batch-run-{name}");
+        let run_ref = AgentRunRef::new(agent_id, run_id.clone());
+        session
+            .services
+            .agent_control
+            .register_run_running(run_ref.clone());
+        agents.push(agent_id);
+        targets.push(target.clone());
+        runs.push(run_ref);
+        arguments.push(json!({"target": target, "run_id": run_id}));
+    }
+
+    let mut pending = JoinAgentsHandler.handle(invocation(
+        session.clone(),
+        turn.clone(),
+        "join_agents",
+        function_payload(json!({"runs": arguments})),
+    ));
+    assert!(
+        timeout(Duration::from_millis(50), pending.as_mut())
+            .await
+            .is_err(),
+        "join_agents should remain pending before any run is terminal"
+    );
+
+    for (index, run) in runs.iter().take(2).enumerate() {
+        session.services.agent_control.complete_run(
+            run.clone(),
+            Arc::new(AgentRunTerminal {
+                outcome: AgentRunOutcome::Completed {
+                    output: Some(format!("child-{index}")),
+                },
+            }),
+        );
+        assert!(
+            timeout(Duration::from_millis(50), pending.as_mut())
+                .await
+                .is_err(),
+            "join_agents should remain pending after only {} terminal runs",
+            index + 1
+        );
+    }
+
+    session.services.agent_control.complete_run(
+        runs[2].clone(),
+        Arc::new(AgentRunTerminal {
+            outcome: AgentRunOutcome::Completed {
+                output: Some("child-2".to_string()),
+            },
+        }),
+    );
+    let output = timeout(Duration::from_secs(1), pending.as_mut())
+        .await
+        .expect("join_agents should finish after every run is terminal")
+        .expect("join_agents should succeed");
+    let (content, success) = expect_text_output(output);
+    let result: serde_json::Value =
+        serde_json::from_str(&content).expect("join_agents result should be json");
+    let results = result["results"]
+        .as_array()
+        .expect("join_agents results should be an array");
+    assert_eq!(results.len(), 3);
+    for (index, result) in results.iter().enumerate() {
+        assert_eq!(result["target"], json!(targets[index]));
+        assert_eq!(result["run_id"], json!(runs[index].run_id));
+        assert_eq!(result["status"], json!("completed"));
+        assert_eq!(result["output"], json!(format!("child-{index}")));
+    }
+    assert_eq!(success, Some(true));
+
+    for agent_id in agents {
+        let _ = manager
+            .agent_control()
+            .shutdown_live_agent(agent_id)
+            .await
+            .expect("shutdown spawned agent");
+    }
+}
