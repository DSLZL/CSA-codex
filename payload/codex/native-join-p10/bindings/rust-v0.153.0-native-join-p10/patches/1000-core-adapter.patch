+pub fn create_join_agents_tool_v2() -> ToolSpec {
+    let run_properties = BTreeMap::from([
+        (
+            "target".to_string(),
+            JsonSchema::string(Some(
+                "Relative or canonical task name, or native child thread id.".to_string(),
+            )),
+        ),
+        (
+            "run_id".to_string(),
+            JsonSchema::string(Some(
+                "Opaque exact run id returned by spawn_agent. Pass it unchanged.".to_string(),
+            )),
+        ),
+    ]);
+    let properties = BTreeMap::from([(
+        "runs".to_string(),
+        JsonSchema::array(
+            JsonSchema::object(
+                run_properties,
+                Some(vec!["target".to_string(), "run_id".to_string()]),
+                Some(false.into()),
+            ),
+            Some(
+                "All exact child runs returned by spawn_agent. Include every run once.".to_string(),
+            ),
+        ),
+    )]);
+
+    ToolSpec::Function(ResponsesApiTool {
+        name: "join_agents".to_string(),
+        description: "Wait for all supplied native subagent runs in one call. Use this after spawning multiple agents so the parent resumes only once, after every exact target/run_id pair has completed, failed, or been cancelled. Do not call join_agent separately for each run, repeatedly call wait_agent, or query status while this call is pending."
+            .to_string(),
+        strict: false,
+        defer_loading: None,
+        parameters: JsonSchema::object(
+            properties,
+            Some(vec!["runs".to_string()]),
+            Some(false.into()),
+        ),
+        output_schema: Some(join_agents_output_schema()),
+    })
+}
