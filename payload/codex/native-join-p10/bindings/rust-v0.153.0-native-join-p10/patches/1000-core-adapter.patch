+#[tokio::test]
+async fn spawned_v2_terminal_events_publish_replayable_exact_run_outcomes() {
+    let cases = [
+        (
+            "completed",
+            EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: "completed".to_string(),
+                last_agent_message: Some("done".to_string()),
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+            None,
+            AgentRunOutcome::Completed {
+                output: Some("done".to_string()),
+            },
+        ),
+        (
+            "no-output",
+            EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: "no-output".to_string(),
+                last_agent_message: None,
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+            None,
+            AgentRunOutcome::Completed { output: None },
+        ),
+        (
+            "failed",
+            EventMsg::TurnComplete(TurnCompleteEvent {
+                turn_id: "failed".to_string(),
+                last_agent_message: None,
+                error: None,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+                time_to_first_token_ms: None,
+            }),
+            Some(ErrorEvent {
+                misalignment: None,
+                message: "child failed".to_string(),
+                codex_error_info: None,
+            }),
+            AgentRunOutcome::Failed {
+                message: "child failed".to_string(),
+                reason: None,
+            },
+        ),
+        (
+            "interrupted",
+            EventMsg::TurnAborted(TurnAbortedEvent {
+                turn_id: Some("interrupted".to_string()),
+                reason: TurnAbortReason::Interrupted,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+            }),
+            None,
+            AgentRunOutcome::Cancelled {
+                reason: "interrupted".to_string(),
+            },
+        ),
+        (
+            "budget-limited",
+            EventMsg::TurnAborted(TurnAbortedEvent {
+                turn_id: Some("budget-limited".to_string()),
+                reason: TurnAbortReason::BudgetLimited,
+                started_at: None,
+                completed_at: None,
+                duration_ms: None,
+            }),
+            None,
+            AgentRunOutcome::Failed {
+                message: "child run exceeded its token budget".to_string(),
+                reason: Some("budget_limited".to_string()),
+            },
+        ),
+    ];
+
+    for (run_id, event, terminal_error, expected) in cases {
+        let (session, mut turn_context, _rx) = make_session_and_context_with_rx().await;
+        let context = Arc::get_mut(&mut turn_context).expect("unshared test turn context");
+        context.sub_id = run_id.to_string();
+        context.multi_agent_version = MultiAgentVersion::V2;
+        context.session_source = SessionSource::SubAgent(SubAgentSource::ThreadSpawn {
+            parent_thread_id: ThreadId::new(),
+            depth: 1,
+            agent_path: None,
+            agent_nickname: None,
+            agent_role: None,
+        });
+        *context.terminal_error.lock().await = terminal_error;
+
+        let target = AgentRunRef::new(session.thread_id, run_id.to_string());
+        session
+            .maybe_notify_parent_of_terminal_turn(context, &event)
+            .await;
+        session
+            .services
+            .agent_control
+            .register_run_running(target.clone());
+        let terminal = timeout(
+            StdDuration::from_secs(1),
+            crate::agent::completion::join_one(&session.services.agent_control, &target),
+        )
+        .await
+        .expect("published terminal should replay immediately")
+        .expect("published exact run");
+        assert_eq!(terminal.outcome, expected, "run {run_id}");
+        assert!(context.terminal_error.lock().await.is_none());
+    }
+}
