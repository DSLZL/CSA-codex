+#[tokio::test]
+async fn spawned_child_inherits_parent_http_fallback_for_the_same_provider() {
+    let (home, mut config) = test_config().await;
+    config.model_provider.supports_websockets = true;
+    let harness = AgentControlHarness::new_with_config(home, config).await;
+    let (parent_thread_id, parent_thread) = harness.start_thread().await;
+    let turn = parent_thread.session.new_default_turn().await;
+    assert!(
+        parent_thread
+            .session
+            .services
+            .model_client
+            .force_http_fallback(&turn.session_telemetry, turn.model_info().as_ref())
+    );
+
+    let child_thread_id = harness
+        .spawn_anonymous_child(parent_thread_id, SpawnAgentOptions::default())
+        .await;
+    let child_thread = harness
+        .manager
+        .get_thread(child_thread_id)
+        .await
+        .expect("spawned child should be registered");
+
+    assert!(
+        !child_thread
+            .session
+            .services
+            .model_client
+            .responses_websocket_enabled(),
+        "a child must not repeat a WebSocket transport failure already resolved by its parent"
+    );
+}
