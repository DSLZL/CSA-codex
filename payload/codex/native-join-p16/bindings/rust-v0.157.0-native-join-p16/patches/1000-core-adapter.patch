+    tokio::fs::create_dir_all(&sqlite_home)
+        .await
+        .expect("sqlite home should be created");
+    let _cleanup = scopeguard::guard(sqlite_home.clone(), |sqlite_home| {
+        let _ = std::fs::remove_dir_all(sqlite_home);
+    });
+    let sqlite = crate::SqliteConfig::new_for_testing(sqlite_home.as_path().abs());
+    let state_path = sqlite.state_db_path();
+    let legacy = Migrator::with_migrations(
+        STATE_MIGRATOR
+            .migrations
+            .iter()
+            .map(|migration| {
+                Migration::new(
+                    migration.version,
+                    migration.description.clone(),
+                    migration.migration_type,
+                    sqlx::AssertSqlSafe(migration.sql.as_str().replace("\r\n", "\n"))
+                        .into_sql_str(),
+                    migration.no_tx,
+                )
+            })
+            .collect(),
+    );
+    let pool = sqlite
+        .open_read_write_pool(&state_path)
+        .await
+        .expect("legacy database should open");
+    legacy
+        .run(&pool)
+        .await
+        .expect("legacy LF migrations should apply");
+    insert_migration_line_endings_sentinel(&pool).await;
+    let before = migration_history(&pool).await;
+    pool.close().await;
+
+    let error = sqlite
+        .open_state_db(&runtime_state_migrator(), /*telemetry_override*/ None)
+        .await
+        .expect_err("a known EOL mismatch must not trigger a database rewrite");
+    assert!(
+        error
+            .to_string()
+            .contains("migration 1 was previously applied but has been modified")
+    );
+    let pool = sqlite
+        .open_read_write_pool(&state_path)
+        .await
+        .expect("database should reopen for verification");
+    assert_eq!(migration_history(&pool).await, before);
+    assert_migration_line_endings_sentinel(&pool).await;
+    pool.close().await;
+}
