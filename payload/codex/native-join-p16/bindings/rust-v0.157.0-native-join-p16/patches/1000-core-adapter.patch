+async fn multi_agent_v2_followup_reuses_busy_and_completed_worker_history() -> Result<()> {
+    const PARENT_ONLY: &str = "parent-private-resume-routing-context";
+    const START_PROMPT: &str = "parent-private-resume-routing-context: start the original worker";
+    const BUSY_PROMPT: &str = "parent-private-resume-routing-context: send the failed test details";
+    const OMIT_PROMPT: &str = "parent-private-resume-routing-context: request the small omission";
+    const BUSY_TASK: &str = "Test failure: fix the parser validation case in your original work";
+    const BUSY_RESULT: &str = "Original worker fixed the parser validation failure";
+    const OMIT_TASK: &str = "Small omission: add the missing assertion to your validation case";
+    const GATE_ID: &str = "original-worker-resume-routing-gate";
+    const GATE_CALL_ID: &str = "original-worker-pending-tool";
+
+    let server = start_mock_server().await;
+    let model_provider_base_url = format!("{}/v1", server.uri());
+    let test = test_codex()
+        .with_config(move |config| {
+            configure_multi_agent_v2_with_role(config, &model_provider_base_url);
+        })
+        .with_model_info_override(ROLE_MODEL, |model| {
+            model
+                .experimental_supported_tools
+                .push("test_sync_tool".to_string());
+        })
+        // The catalog override also selects the model; keep root requests distinct.
+        .with_model("gpt-5.5")
+        .build_with_auto_env(&server)
+        .await?;
+    let root_thread_id = test.session_configured.thread_id;
+    let mut created_threads = test.thread_manager.subscribe_thread_created();
+    mount_root_collaboration_call(
+        &server,
+        START_PROMPT,
+        "spawn-original-worker",
+        "spawn_agent",
+        &json!({
+            "task_name": "worker",
+            "agent_type": ROLE_NAME,
+            "message": INITIAL_TASK,
+        })
+        .to_string(),
+    )
+    .await;
+    let initial_request = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            request_has_model(request, ROLE_MODEL) && body_contains(request, INITIAL_TASK)
+        },
+        sse(vec![
+            ev_response_created("resp-original-worker-busy"),
+            ev_function_call(
+                GATE_CALL_ID,
+                "test_sync_tool",
+                &json!({"barrier": {"id": GATE_ID, "participants": 2, "timeout_ms": 30_000}})
+                    .to_string(),
+            ),
+            ev_completed("resp-original-worker-busy"),
+        ]),
+    )
+    .await;
+    test.submit_turn(START_PROMPT).await?;
+    let worker_thread_id = timeout(Duration::from_secs(5), created_threads.recv()).await??;
+    let worker = test.thread_manager.get_thread(worker_thread_id).await?;
+    timeout(
+        Duration::from_secs(5),
+        wait_for_test_sync_barrier_arrivals(GATE_ID, /*arrivals*/ 1),
+    )
+    .await
+    .expect("original worker should reach the pending tool gate");
+    assert_eq!(worker.agent_status().await, AgentStatus::Running);
+
+    mount_root_collaboration_call(
+        &server,
+        BUSY_PROMPT,
+        "followup-busy-worker",
+        "followup_task",
+        &json!({"target": worker_thread_id.to_string(), "message": BUSY_TASK}).to_string(),
+    )
+    .await;
+    let busy_request = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            request_has_model(request, ROLE_MODEL) && body_contains(request, BUSY_TASK)
+        },
+        sse(vec![
+            ev_response_created("resp-original-worker-fixed"),
+            ev_assistant_message("msg-original-worker-fixed", BUSY_RESULT),
+            ev_completed("resp-original-worker-fixed"),
+        ]),
+    )
+    .await;
+    test.submit_turn(BUSY_PROMPT).await?;
+    assert_eq!(worker.agent_status().await, AgentStatus::Running);
+    assert!(busy_request.requests().is_empty());
+    assert_eq!(test.thread_manager.list_thread_ids().await.len(), 2);
+    wait_on_test_sync_barrier(GATE_ID, /*participants*/ 2, /*timeout_ms*/ 30_000)
+        .await
+        .map_err(anyhow::Error::msg)?;
+    wait_for_event(worker.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+
+    mount_root_collaboration_call(
+        &server,
+        OMIT_PROMPT,
+        "followup-completed-worker",
+        "followup_task",
+        &json!({"target": "worker", "message": OMIT_TASK}).to_string(),
+    )
+    .await;
+    let completed_request = mount_sse_once_match(
+        &server,
+        |request: &wiremock::Request| {
+            request_has_model(request, ROLE_MODEL) && body_contains(request, OMIT_TASK)
+        },
+        sse(vec![
+            ev_response_created("resp-original-worker-omission"),
+            ev_assistant_message("msg-original-worker-omission", "Missing assertion added"),
+            ev_completed("resp-original-worker-omission"),
+        ]),
+    )
+    .await;
+    test.submit_turn(OMIT_PROMPT).await?;
+    wait_for_event(worker.as_ref(), |event| {
+        matches!(event, EventMsg::TurnComplete(_))
+    })
+    .await;
+
+    let initial = initial_request.single_request();
+    let busy = busy_request.single_request();
+    let completed = completed_request.single_request();
+    for request in [&initial, &busy, &completed] {
+        let body = request.body_json();
+        assert_eq!(
+            body["client_metadata"]["thread_id"],
+            json!(worker_thread_id)
+        );
+        assert_eq!(
+            body["client_metadata"]["x-codex-parent-thread-id"],
+            json!(root_thread_id)
+        );
+        assert!(request.body_contains_text(INITIAL_TASK));
+        assert!(request.body_contains_text(ROLE_DEVELOPER_INSTRUCTIONS));
+        assert!(!request.body_contains_text(PARENT_ONLY));
+        assert!(
+            request
+                .inputs_of_type("agent_message")
+                .iter()
+                .any(|item| { item["author"] == "/root" && item["recipient"] == "/root/worker" })
+        );
+    }
+    for request in [&busy, &completed] {
+        assert!(request.body_contains_text(GATE_CALL_ID));
+        assert!(request.body_contains_text(BUSY_TASK));
+    }
+    assert!(completed.body_contains_text(BUSY_RESULT));
+    assert!(completed.body_contains_text(OMIT_TASK));
+    let thread_ids = test.thread_manager.list_thread_ids().await;
+    assert_eq!(thread_ids.len(), 2);
+    assert!(thread_ids.contains(&root_thread_id));
+    assert!(thread_ids.contains(&worker_thread_id));
+    assert!(created_threads.try_recv().is_err());
+    Ok(())
+}
