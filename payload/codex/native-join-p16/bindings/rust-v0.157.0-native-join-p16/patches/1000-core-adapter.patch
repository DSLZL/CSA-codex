+pub(crate) async fn wait_for_barrier_arrivals_for_tests(id: &str, arrivals: usize) {
+    loop {
+        if barrier_map()
+            .lock()
+            .await
+            .get(id)
+            .is_some_and(|state| state.arrivals >= arrivals)
+        {
+            return;
+        }
+        tokio::task::yield_now().await;
+    }
+}
+
+pub(crate) async fn wait_on_barrier_for_tests(
+    id: &str,
+    participants: usize,
+    timeout_ms: u64,
+) -> Result<(), String> {
+    wait_on_barrier(BarrierArgs {
+        id: id.to_string(),
+        participants,
+        timeout_ms,
+    })
+    .await
+    .map_err(|err| format!("{err:?}"))
+}
